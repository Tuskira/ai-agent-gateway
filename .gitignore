/out/
/dist/
*.exe
*.test
*.out
.env
.env.*
/web/node_modules/
/web/dist/
.DS_Store

# Vite build output embedded via go:embed (internal/api/ui/ui.go). Keep
# dist/.gitkeep so the package compiles before the UI has ever been built.
/internal/api/ui/dist/*
!/internal/api/ui/dist/.gitkeep
/bin/

# Generated by `make notices` (tools/notices) at build/release time, not
# committed -- see .goreleaser.yaml and .github/workflows/ci.yml.
/THIRD_PARTY_NOTICES
/detection/THIRD_PARTY_NOTICES

# Local integration harness (reads dev creds at runtime; not for the shared repo)
deploy/e2e_harness.py

# Example run.sh runtime state: the local MCP server's pid/log files.
examples/**/.everything.pid
examples/**/.everything.log

# Example run.sh runtime state: 06-credentials-and-headers' header-echo
# server pid/log files (same pattern as .everything.pid/.log above).
examples/**/.header-echo.pid
examples/**/.header-echo.log

# Example run.sh runtime state: per-example Python venvs and local env files.
examples/**/.venv/
examples/**/.env
__pycache__/
