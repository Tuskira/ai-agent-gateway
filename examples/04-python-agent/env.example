# Gateway base URL. The MCP plane (:8080) and LLM plane (:8082) are derived
# from its host.
GATEWAY_URL=http://localhost

# Agent-role API key minted by run.sh (POST /api/v1/api-keys, role "agent").
GATEWAY_KEY=gk_...

# X-Agent-Profile-Name sent on every MCP request; must be granted get-sum
# and echo on the "everything" connector (run.sh does this).
PROFILE=04-python-agent

# Your own Anthropic key (BYOK) -- passed through the LLM plane unchanged.
# Required when MODEL is a Claude model (not kimi-k3 / glm-5.3); omit it (or
# run --mcp-only) to skip the LLM half.
ANTHROPIC_API_KEY=sk-ant-...

# Model to start with. Override to try a different one (kimi-k3, glm-5.3, ...).
MODEL=claude-sonnet-5

# Open-weight models: run.sh stores ONE of these as a gateway credential and
# registers kimi-k3 / glm-5.3 with it; agent.py --chat then switches between
# them with /model. The agent itself never sees it -- and needs no
# ANTHROPIC_API_KEY for those models.
# NEBIUS_API_KEY=...
# TOGETHER_API_KEY=...
