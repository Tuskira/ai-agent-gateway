# syntax=docker/dockerfile:1
#
# Docker image used ONLY by `goreleaser release` (.goreleaser.yaml
# `dockers:`), not by `make docker-build` or `docker compose` -- see
# Dockerfile for the from-source multi-stage build those use.
#
# GoReleaser cross-compiles the `gateway` binary for each OS/arch itself
# (its `builds:` stage) *before* this file runs, from a tree where
# internal/api/ui/dist was already populated by the release workflow's
# "web" step -- the React console is go:embed'd in at that `go build`,
# so it's already inside the binary below. This Dockerfile's only job is
# to place that prebuilt, already-UI-embedded binary into the same
# distroless base image Dockerfile uses; it does not build anything from
# source and does not need Go, Node, or the repo source tree.
FROM gcr.io/distroless/static-debian12:nonroot

# GoReleaser copies the binary matching this image's target platform into
# the build context under its build id ("gateway"; see .goreleaser.yaml
# dockers[].ids) before invoking `docker buildx build`.
COPY gateway /gateway

# LICENSE, NOTICE, and THIRD_PARTY_NOTICES (generated by `make notices` in
# .goreleaser.yaml's before.hooks) reach this build context via dockers[].
# extra_files in .goreleaser.yaml -- this Dockerfile never builds from
# source, so it can't run that generation step itself. See Dockerfile (the
# from-source build) for the from-scratch equivalent of this stage.
COPY LICENSE NOTICE THIRD_PARTY_NOTICES /licenses/

EXPOSE 8080 8081 8082

ENTRYPOINT ["/gateway"]
