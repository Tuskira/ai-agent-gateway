# Agent-role API key, minted via POST /api/v1/api-keys (role "agent") --
# see the README's Prerequisites. Referenced as ${GATEWAY_KEY} in
# .mcp.json and passed to claude-mcp-add.sh / claude mcp add --header.
GATEWAY_KEY=gk_...

# X-Agent-Profile-Name sent on every MCP request -- must already be
# granted the tools you want Claude Code to see (see 05-profiles).
PROFILE=Full Access

# Only needed for step 2 (optional): routes Claude Code's own model calls
# through the gateway's LLM plane too. Leave both unset to skip it --
# Claude Code talks to Anthropic directly, same as always.
ANTHROPIC_BASE_URL=http://localhost:8082
ANTHROPIC_CUSTOM_HEADERS=X-Gateway-Key: gk_...
